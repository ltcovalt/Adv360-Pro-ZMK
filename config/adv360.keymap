#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    flavor = "balanced";
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 46 47 48 49 50 51 60 61 62 63 64>;
        };

        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <200>;
            require-prior-idle-ms = <175>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <7 8 9 10 11 12 13 21 22 23 24 25 26 27 39 40 41 42 43 44 45 54 55 56 57 58 59 71 72 73 74 75>;
        };

        lth: lth {
            compatible = "zmk,behavior-hold-tap";
            label = "LT Prefer Hold";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        system {
            bindings = <&mo 4>;
            key-positions = <66 69>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&kp GRAVE  &kp N1         &kp N2        &kp N3        &kp N4  &kp N5  &none                                                                   &none         &kp N6  &kp N7  &kp N8            &kp N9          &kp N0             &kp MINUS
&kp TAB    &kp Q          &kp W         &kp F         &kp P   &kp B   &none                                                                   &none         &kp J   &kp L   &kp U             &kp Y           &kp SQT            &kp BSLH
&kp ESC    &kp A          &kp R         &kp S         &kp T   &kp G   &none           &mo 4            &kp LGUI       &kp RGUI   &mo 4        &none         &kp M   &kp N   &kp E             &kp I           &kp O              &kp SQT
&kp LSHFT  &hrml LCTRL Z  &hrml LALT X  &hrml LGUI C  &kp D   &kp V                                    &kp LALT       &kp RALT                              &kp K   &kp H   &hrmr RGUI COMMA  &hrmr RALT DOT  &hrmr RCTRL SLASH  &kp ENTER
&none      &none          &none         &none         &none           &kp LEFT_SHIFT  &lt 3 BACKSPACE  &kp LCTRL      &kp RCTRL  &lt 3 SPACE  &lth 2 ENTER          &kp UP  &kp DOWN          &kp LBKT        &kp RBKT           &none
            >;

            label = "default";
        };

        game {
            bindings = <
&trans  &kp NUMBER_1      &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                                         &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp I             &kp Q         &kp W         &kp E         &kp R         &kp J                                                &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LSHFT         &kp A         &kp S         &kp D         &kp F         &kp M         &trans     &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LEFT_CONTROL  &kp Z         &kp X         &kp C         &kp V                                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp PAUSE_BREAK   &kp T         &kp G         &kp B                       &mo 3         &kp SPACE  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            label = "game";
        };

        number {
            bindings = <
&kp F12  &kp F1        &kp F2      &kp F3         &kp F4        &kp F5         &trans                                      &trans  &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &kp F11
&trans   &kp LS(EXCL)  &kp LS(AT)  &kp LS(POUND)  &kp LS(DLLR)  &kp LS(PRCNT)  &trans                                      &trans  &kp LS(CARET)  &kp LS(AMPS)  &kp LS(STAR)  &kp LS(LPAR)  &kp LS(RPAR)  &trans
&trans   &kp N1        &kp N2      &kp N3         &kp N4        &kp N5         &trans  &trans  &trans      &trans  &trans  &trans  &kp N6         &kp N7        &kp N8        &kp N9        &kp N0        &trans
&trans   &kp F1        &kp F2      &kp F3         &kp F4        &kp F5                         &trans      &trans                  &kp F6         &kp F7        &kp F8        &kp F9        &kp F10       &trans
&trans   &trans        &trans      &trans         &trans                       &trans  &trans  &trans      &trans  &trans  &trans                 &kp F11       &kp F12       &trans        &trans        &trans
            >;

            label = "num/fn";
        };

        symbol {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN    &kp POUND  &kp DOLLAR  &kp PERCENT           &trans                                      &trans  &kp CARET              &kp AMPERSAND   &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE
&trans     &kp TAB          &kp BACKSPACE  &kp UP     &kp DELETE  &kp LEFT_BRACKET      &trans                                      &trans  &kp RIGHT_BRACKET      &kp GRAVE       &kp PLUS       &kp PIPE              &kp COLON              &kp PIPE
&trans     &kp LEFT_SHIFT   &kp LEFT       &kp DOWN   &kp RIGHT   &kp LEFT_PARENTHESIS  &trans  &trans  &trans      &trans  &trans  &trans  &kp RIGHT_PARENTHESIS  &kp MINUS       &kp EQUAL      &kp BACKSLASH         &kp SEMI               &kp DOUBLE_QUOTES
&trans     &kp LGUI         &trans         &kp HOME   &kp END     &kp LEFT_BRACE                        &trans      &trans                  &kp RIGHT_BRACE        &kp UNDERSCORE  &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION           &trans
&trans     &trans           &trans         &trans     &trans                            &trans  &trans  &trans      &trans  &trans  &trans                         &trans          &trans         &trans                &trans                 &trans
            >;

            label = "symbol";
        };

        system {
            bindings = <
&kp C_SLEEP  &to 0          &to 1         &trans            &trans        &trans        &trans                                      &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &trans         &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &kp C_BRI_UP  &trans                                      &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans       &kp LS(LG(S))  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &kp C_BRI_DN  &trans  &trans  &trans      &trans  &trans  &trans  &trans        &bl BL_DEC    &bl BL_TOG    &bl BL_INC    &trans        &trans
&trans       &kp F1         &kp F2        &kp F3            &kp F4        &kp F5                        &trans      &trans                  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &trans
&bootloader  &trans         &trans        &trans            &trans                      &trans  &trans  &trans      &trans  &trans  &trans                &kp F11       &kp F12       &trans        &trans        &bootloader
            >;

            label = "system";
        };
    };
};
